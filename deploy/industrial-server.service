[Unit]
Description=Industrial Workcell Monitoring Server
After=network.target

[Service]
Type=simple
User=industrial
Group=industrial
ExecStart=/opt/industrial/industrial-server --sim --port 9600
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
